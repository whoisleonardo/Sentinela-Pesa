# Copie para .env se for rodar o backend fora do Docker Compose (npm run dev)
# Portas de host alinhadas com docker-compose.yml (5442/6379/9092 expostos
# pelos containers postgres/redis/redpanda; ajuste se remapear no compose)
PORT=4000
DATABASE_URL=postgres://sentinela:sentinela@localhost:5442/sentinela
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
